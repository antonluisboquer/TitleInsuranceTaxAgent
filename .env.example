# Required to run the agent end-to-end (the LLM-orchestrated react agent
# that decides which validation tool to call). Not required to run the test
# suite, which exercises the deterministic tool functions directly.
OPENAI_API_KEY=

# Model used by the agent's create_react_agent (a langchain init_chat_model
# identifier, e.g. "openai:gpt-4o-mini" or "anthropic:claude-...").
TITLE_INSURANCE_TAX_AGENT_MODEL=openai:gpt-4o-mini

# --- Encompass (core/encompass_client.py + core/los_client.EncompassLOSClient) ---
# Not wired into any tool yet (this agent currently takes loan_context as a
# plain dict), but available for populating that context from a real loan in
# production instead of a caller-supplied dict. Vendored from
# LG-ConstructionEncompass/encompass_client.py — confirmed live against Prod
# 2026-10-21.
TEST_ENCOMPASS_CLIENT_ID=
TEST_ENCOMPASS_CLIENT_SECRET=
TEST_ENCOMPASS_INSTANCE_ID=
TEST_ENCOMPASS_API_BASE_URL=https://api.elliemae.com

PROD_ENCOMPASS_CLIENT_ID=
PROD_ENCOMPASS_CLIENT_SECRET=
PROD_ENCOMPASS_INSTANCE_ID=
PROD_ENCOMPASS_USERNAME=
PROD_ENCOMPASS_PASSWORD=
PROD_ENCOMPASS_SUBJECT_USER_ID=
PROD_ENCOMPASS_API_BASE_URL=https://api.elliemae.com
