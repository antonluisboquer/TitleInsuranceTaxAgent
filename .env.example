# Required to run the agent end-to-end (the LLM-orchestrated react agent
# that decides which validation tool to call). Not required to run the test
# suite, which exercises the deterministic tool functions directly.
OPENAI_API_KEY=

# Model used by the agent's create_react_agent (a langchain init_chat_model
# identifier, e.g. "openai:gpt-4o-mini" or "anthropic:claude-...").
TITLE_INSURANCE_TAX_AGENT_MODEL=openai:gpt-4o-mini
